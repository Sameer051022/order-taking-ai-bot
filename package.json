{
  "name": "ai-ordering-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise-capable AI ordering agent for restaurants (WhatsApp-first, backend-authoritative)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed/index.ts",
    "reset": "rm -f data/app.db && tsx src/seed/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "record": "tsx scripts/record-demo.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
